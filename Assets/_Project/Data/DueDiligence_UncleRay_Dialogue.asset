  m_Script: {fileID: 11500000, guid: 52d9d4aa603efbf4ab09085a009aab09, type: 3}
  m_Name: DueDiligence_UncleRay_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: Uncle Ray
  npcTitle: Garage Owner & Mentor
  dialogueLines:
  - text: '"You''re looking at that car wash for sale? Good eye, kid. But don''t
      rush into it."'
    delayAfter: 1
    voiceClip: {fileID: 0}
  - text: '"First rule of investing: do your due diligence. That means check the
      books - how much does it make each month? What are the expenses?"'
    delayAfter: 1
    voiceClip: {fileID: 0}
  - text: '"Look for hidden costs too. Equipment maintenance, water bills, insurance.
      The price tag is just the start."'
    delayAfter: 1
    voiceClip: {fileID: 0}
  - text: "\"Go talk to Maria at the caf\xE9. She knows business numbers better than
      anyone. Get her take on it before you commit to anything.\""
    delayAfter: 1
    voiceClip: {fileID: 0}
  lessonTopic: Investment Due Diligence
  lessonSummary: Always research before investing. Check cash flow, expenses, and
    potential risks.
  linkedMissionID: due_diligence
  advancesMission: 0
