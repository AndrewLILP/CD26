MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52d9d4aa603efbf4ab09085a009aab09, type: 3}
  m_Name: Dialogue_Maria_CashFlow
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: Maria
  npcTitle: Cafe Owner
  dialogueLines:
  - text: '"Hey there! You''re new around here, aren''t you? I''m Maria. I run this
      little cafe."'
    delayAfter: 0.5
    voiceClip: {fileID: 0}
  - text: '"You know, I''ve been in business for 5 years now. Started with nothing
      but a dream and a $10,000 loan."'
    delayAfter: 0.5
    voiceClip: {fileID: 0}
  - text: '"The secret? Understanding CASH FLOW. It''s not about how much money you
      make - it''s about how much you KEEP."'
    delayAfter: 0.5
    voiceClip: {fileID: 0}
  - text: '"Every month, money flows IN from coffee sales. But I also have money
      flowing OUT - rent, supplies, wages."'
    delayAfter: 0.5
    voiceClip: {fileID: 0}
  - text: '"As long as more flows IN than OUT, I stay in business. That''s positive
      cash flow."'
    delayAfter: 0.5
    voiceClip: {fileID: 0}
  - text: '"Most people work for a PAYCHECK. That''s linear income - you stop working,
      the money stops."'
    delayAfter: 0.5
    voiceClip: {fileID: 0}
  - text: '"But if you understand cash flow, you can build PASSIVE income. Money
      that flows in even when you''re sleeping."'
    delayAfter: 0.5
    voiceClip: {fileID: 0}
  - text: '"Speaking of which... Uncle Ray asked me to send you his way. He''s waiting
      at the garage down the street."'
    delayAfter: 0.5
    voiceClip: {fileID: 0}
  lessonTopic: Cash Flow
  lessonSummary: Money flowing IN vs OUT. Positive cash flow = financial freedom.
  linkedMissionID: coffee_run
  advancesMission: 0
