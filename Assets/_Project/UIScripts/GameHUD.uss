/* ===================================
   CD26 - Game HUD Styles
   Sprint 4: Added 1992 Dialogue System
   =================================== */
/* Use Unity's default monospace font instead */
.retro-text {
    -unity-font-style: normal;
    font-size: 14px;
}

/* Base Container */
.hud-container {
    width: 100%;
    height: 100%;
    position: absolute;
}

/* Info Panel (Top Right - Cash Display) */
.info-panel {
    position: absolute;
    top: 20px;
    right: 20px;
}

.cash-display {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 10px 15px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(100, 200, 100);
}

.cash-current {
    color: rgb(100, 255, 100);
    font-size: 28px;
    -unity-font-style: bold;
    margin-right: 5px;
}

.cash-goal {
    color: rgb(150, 150, 150);
    font-size: 18px;
    -unity-text-align: middle-left;
}

/* Speedometer (Bottom Left) */
.speedometer {
    position: absolute;
    bottom: 30px;
    left: 30px;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 15px 20px;
    border-radius: 10px;
    border-width: 3px;
    border-color: rgb(255, 100, 100);
}

.speed-value {
    color: rgb(255, 150, 150);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.speed-unit {
    color: rgb(200, 200, 200);
    font-size: 16px;
    -unity-text-align: middle-center;
}

/* Interaction Prompt (Bottom Center) */
.interaction-prompt {
    position: absolute;
    bottom: 80px;
    left: 50%;
    translate: -50% 0;
    background-color: rgba(0, 0, 0, 0.85);
    padding: 12px 20px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(255, 220, 100);
}

.interaction-text {
    color: rgb(255, 255, 150);
    font-size: 20px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

/* Pause Menu */
.pause-menu {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    justify-content: center;
    align-items: center;
}

.pause-panel {
    background-color: rgb(30, 30, 30);
    padding: 40px;
    border-radius: 10px;
    border-width: 3px;
    border-color: rgb(150, 150, 150);
    min-width: 400px;
}

.pause-title {
    color: white;
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 30px;
}

.volume-label {
    color: rgb(200, 200, 200);
    font-size: 18px;
    margin-bottom: 10px;
}

.volume-slider {
    margin-bottom: 5px;
}

.volume-percentage {
    color: rgb(100, 200, 255);
    font-size: 24px;
    -unity-text-align: upper-center;
    margin-bottom: 20px;
}

.menu-button {
    background-color: rgb(50, 50, 50);
    color: white;
    font-size: 20px;
    padding: 15px;
    margin-top: 10px;
    border-radius: 5px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
}

.menu-button:hover {
    background-color: rgb(70, 70, 70);
    border-color: rgb(150, 150, 150);
}

/* Mission Panel */
.mission-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
}

.mission-border {
    background-color: rgb(20, 20, 20);
    padding: 30px;
    border-width: 4px;
    border-color: rgb(255, 200, 0);
    min-width: 500px;
    max-width: 700px;
}

.mission-header {
    color: rgb(255, 200, 0);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 15px;
    letter-spacing: 2px;
}

.mission-name {
    color: white;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 20px;
}

.mission-description {
    color: rgb(200, 200, 200);
    font-size: 18px;
    -unity-text-align: upper-left;
    margin-bottom: 25px;
    white-space: normal;
}

.reward-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
}

.reward-label {
    color: rgb(100, 255, 100);
    font-size: 20px;
    -unity-font-style: bold;
    margin-right: 10px;
}

.mission-reward-value {
    color: rgb(100, 255, 100);
    font-size: 28px;
    -unity-font-style: bold;
}

.mission-button {
    background-color: rgb(255, 200, 0);
    color: black;
    font-size: 18px;
    -unity-font-style: bold;
    padding: 15px;
    border-width: 0;
}

.mission-button:hover {
    background-color: rgb(255, 220, 50);
}

/* ===================================
   NEW: 1992 RETRO DIALOGUE PANEL
   =================================== */

.dialogue-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 50px;
}

.dialogue-border {
    background-color: rgb(0, 20, 40);
    border-width: 4px;
    border-color: rgb(0, 180, 255);
    padding: 0;
    min-width: 700px;
    max-width: 800px;
    /* Retro CRT monitor glow effect */
    box-shadow: 0 0 20px rgba(0, 180, 255, 0.5);
}

.dialogue-header-container {
    background-color: rgb(0, 100, 180);
    padding: 10px 15px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(0, 180, 255);
}

.npc-name {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: upper-left;
    /* Monospace font for retro feel */
    -unity-font: resource('Fonts/CourierNew');
}

.npc-title {
    color: rgb(150, 220, 255);
    font-size: 14px;
    letter-spacing: 1px;
    -unity-text-align: upper-left;
    margin-top: 2px;
}

.dialogue-body {
    background-color: rgb(0, 20, 40);
    padding: 20px 25px;
    min-height: 120px;
}

.dialogue-text {
    color: rgb(220, 255, 255);
    font-size: 18px;
    white-space: normal;
    -unity-text-align: upper-left;
    line-height: 24px;
    /* Monospace for terminal/computer feel */
    -unity-font: resource('Fonts/CourierNew');
}

.continue-prompt {
    background-color: rgb(0, 60, 100);
    padding: 8px 15px;
    border-top-width: 2px;
    border-top-color: rgb(0, 180, 255);
    justify-content: center;
    align-items: center;
}

.continue-text {
    color: rgb(100, 200, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    /* Blinking effect would be ideal, but CSS doesn't support it */
    /* In-game, this could pulse via script */
}

/* Hidden State */
.hidden {
    display: none;
}
