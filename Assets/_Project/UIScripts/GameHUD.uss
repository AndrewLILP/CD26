/* === HUD CONTAINER === */
.hud-container {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* === INFO PANEL (Top-Right) === */
.info-panel {
    position: absolute;
    top: 20px;
    right: 20px;
}

.cash-display {
    padding: 15px 25px;
    background-color: rgba(0, 0, 0, 0.7);
    border-color: rgb(255, 255, 255);
    border-width: 3px;
    border-radius: 10px;
}

.cash-current {
    font-size: 36px;
    color: rgb(0, 255, 0);
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.cash-goal {
    font-size: 18px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-right;
    margin-top: 5px;
}

/* === SPEEDOMETER (Bottom-Left) === */
.speedometer {
    position: absolute;
    bottom: 30px;
    left: 30px;
    padding: 20px 30px;
    background-color: rgba(0, 0, 0, 0.7);
    border-color: rgb(255, 255, 255);
    border-width: 3px;
    border-radius: 10px;
}

.speed-value {
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.speed-unit {
    font-size: 20px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
    margin-top: 5px;
}

/* === INTERACTION PROMPT (Bottom-Center) === */
.interaction-prompt {
    position: absolute;
    bottom: 120px;
    left: 50%;
    translate: -50% 0;
    padding: 15px 40px;
    background-color: rgba(0, 0, 0, 0.85);
    border-color: rgb(255, 255, 255);
    border-width: 3px;
    border-radius: 8px;
}

.interaction-prompt.hidden {
    display: none;
}

.interaction-text {
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: nowrap;
}

/* === PAUSE MENU === */
.pause-menu {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
}

.pause-menu.hidden {
    display: none;
}

.pause-panel {
    width: 400px;
    padding: 30px;
    background-color: rgb(40, 40, 40);
    border-color: rgb(255, 255, 255);
    border-width: 3px;
    border-radius: 10px;
}

.pause-title {
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    margin-bottom: 30px;
}

.volume-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
}

.volume-slider {
    margin-bottom: 10px;
}

.volume-percentage {
    font-size: 18px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
    margin-bottom: 30px;
}

.menu-button {
    height: 50px;
    font-size: 20px;
    margin-bottom: 15px;
    background-color: rgb(80, 80, 80);
    border-color: rgb(255, 255, 255);
    border-width: 2px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.menu-button:hover {
    background-color: rgb(120, 120, 120);
}

/* === MISSION PANEL === */
.mission-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.9);
}

.mission-panel.hidden {
    display: none;
}

/* === RETRO BORDER FRAME === */
.mission-border {
    width: 700px;
    padding: 25px;
    background-color: rgb(10, 37, 64);
    border-color: rgb(0, 255, 255);
    border-width: 5px;
}

/* === MISSION HEADER === */
.mission-header {
    font-size: 28px;
    color: rgb(0, 255, 255);
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    margin-bottom: 20px;
    letter-spacing: 3px;
}

/* === MISSION NAME === */
.mission-name {
    font-size: 42px;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    margin-bottom: 30px;
}

/* === MISSION DESCRIPTION === */
.mission-description {
    font-size: 20px;
    color: rgb(220, 220, 220);
    -unity-text-align: upper-left;
    white-space: normal;
    margin-bottom: 30px;
    padding: 15px;
    background-color: rgba(0, 0, 0, 0.4);
    border-color: rgb(0, 180, 180);
    border-width: 2px;
}

/* === REWARD CONTAINER === */
.reward-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 25px;
    padding: 15px;
    background-color: rgba(0, 255, 255, 0.15);
    border-color: rgb(0, 255, 255);
    border-width: 3px;
}

.reward-label {
    font-size: 22px;
    color: rgb(0, 255, 255);
    -unity-font-style: bold;
    margin-right: 15px;
}

.mission-reward-value {
    font-size: 32px;
    color: rgb(0, 255, 0);
    -unity-font-style: bold;
}

/* === MISSION BUTTON === */
.mission-button {
    height: 60px;
    font-size: 22px;
    color: rgb(0, 0, 0);
    background-color: rgb(0, 255, 255);
    border-color: rgb(255, 255, 255);
    border-width: 4px;
    -unity-font-style: bold;
    margin-top: 10px;
}

.mission-button:hover {
    background-color: rgb(0, 220, 220);
    border-color: rgb(0, 255, 255);
}

.mission-button:active {
    background-color: rgb(0, 180, 180);
}