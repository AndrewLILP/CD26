/* ============================================
   CD26 - GAME HUD STYLESHEET
   1992 Retro Aesthetic - Cyan on Black
   Font declarations removed - uses Unity default
   ============================================ */

/* ============================================
   GLOBAL STYLES
   ============================================ */

.hidden {
    display: none;
}

/* ============================================
   HUD CONTAINER (Main Game HUD)
   ============================================ */

.hud-container {
    width: 100%;
    height: 100%;
    position: absolute;
}

/* ============================================
   INFO PANEL (Top-Left - Cash Display)
   ============================================ */

.info-panel {
    position: absolute;
    top: 20px;
    left: 20px;
}

.cash-display {
    background-color: rgba(0, 0, 0, 0.85);
    border-color: rgb(0, 255, 255); /* Cyan */
    border-width: 2px;
    padding: 10px 15px;
}

.cash-current {
    font-size: 24px;
    color: rgb(0, 255, 0); /* Green for money */
    margin-bottom: 2px;
}

.cash-goal {
    font-size: 14px;
    color: rgb(150, 255, 255); /* Lighter cyan */
}

/* ============================================
   SPEEDOMETER (Bottom-Right)
   ============================================ */

.speedometer {
    position: absolute;
    bottom: 40px;
    right: 40px;
    background-color: rgba(0, 0, 0, 0.85);
    border-color: rgb(0, 255, 255); /* Cyan */
    border-width: 3px;
    padding: 15px 25px;
    align-items: center;
}

.speed-value {
    font-size: 48px;
    color: rgb(0, 255, 255); /* Cyan */
    -unity-text-align: upper-center;
    margin-bottom: 5px;
}

.speed-unit {
    font-size: 16px;
    color: rgb(150, 255, 255); /* Lighter cyan */
    -unity-text-align: upper-center;
}

/* ============================================
   INTERACTION PROMPT (Bottom-Center)
   ============================================ */

.interaction-prompt {
    position: absolute;
    bottom: 120px;
    left: 50%;
    translate: -50% 0;
    background-color: rgba(0, 0, 0, 0.9);
    border-color: rgb(0, 255, 255); /* Cyan */
    border-width: 2px;
    padding: 10px 20px;
}

.interaction-text {
    font-size: 18px;
    color: rgb(0, 255, 255); /* Cyan */
    -unity-text-align: upper-center;
}

/* ============================================
   LAP TIMER PANEL (Top-Right, During Lap)
   ============================================ */

.lap-timer-panel {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: rgba(0, 0, 0, 0.85);
    border-color: rgb(0, 255, 255); /* Cyan */
    border-width: 2px;
    padding: 10px 15px;
    min-width: 200px;
}

.lap-time-current {
    font-size: 18px;
    color: rgb(0, 255, 255); /* Cyan */
    margin-bottom: 5px;
}

.lap-time-best {
    font-size: 16px;
    color: rgb(150, 255, 255); /* Lighter cyan */
}

/* ============================================
   PAUSE MENU (Full Screen Overlay)
   ============================================ */

.pause-menu {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.8);
}

.pause-panel {
    width: 500px;
    background-color: rgb(0, 0, 0);
    border-color: rgb(0, 255, 255); /* Cyan */
    border-width: 4px;
    padding: 40px;
    align-items: center;
}

.pause-title {
    font-size: 48px;
    color: rgb(0, 255, 255); /* Cyan */
    margin-bottom: 30px;
    -unity-text-align: upper-center;
}

.volume-label {
    font-size: 18px;
    color: rgb(0, 255, 255); /* Cyan */
    margin-bottom: 10px;
    -unity-text-align: upper-center;
}

.volume-slider {
    width: 300px;
    margin-bottom: 10px;
}

.volume-slider:focus {
    border-color: rgb(0, 255, 255);
}

.volume-percentage {
    font-size: 20px;
    color: rgb(0, 255, 255); /* Cyan */
    margin-bottom: 30px;
    -unity-text-align: upper-center;
}

.menu-button {
    width: 300px;
    background-color: transparent;
    border-color: rgb(0, 255, 255); /* Cyan */
    border-width: 2px;
    color: rgb(0, 255, 255);
    font-size: 18px;
    padding: 12px 20px;
    margin-bottom: 15px;
    transition-duration: 0.2s;
}

.menu-button:hover {
    background-color: rgb(0, 255, 255);
    color: rgb(0, 0, 0);
}

.menu-button:active {
    background-color: rgb(0, 200, 200);
}

/* ============================================
   MISSION PANEL (Center Screen)
   ============================================ */

.mission-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.8);
}

.mission-border {
    width: 700px;
    background-color: rgb(0, 0, 0);
    border-color: rgb(0, 255, 255); /* Cyan */
    border-width: 4px;
    padding: 40px;
    align-items: center;
}

.mission-header {
    font-size: 24px;
    color: rgb(150, 255, 255); /* Lighter cyan */
    margin-bottom: 15px;
    -unity-text-align: upper-center;
}

.mission-name {
    font-size: 36px;
    color: rgb(0, 255, 255); /* Cyan */
    margin-bottom: 20px;
    -unity-text-align: upper-center;
}

.mission-description {
    font-size: 18px;
    color: rgb(200, 200, 200); /* Light gray */
    margin-bottom: 30px;
    -unity-text-align: upper-center;
    white-space: normal;
    max-width: 600px;
}

.reward-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 25px;
}

.reward-label {
    font-size: 20px;
    color: rgb(0, 255, 255); /* Cyan */
    margin-right: 10px;
}

.mission-reward-value {
    font-size: 28px;
    color: rgb(0, 255, 0); /* Green for money */
}

.mission-button {
    background-color: transparent;
    border-color: rgb(0, 255, 255); /* Cyan */
    border-width: 2px;
    color: rgb(0, 255, 255);
    font-size: 16px;
    padding: 12px 30px;
    margin-top: 10px;
    transition-duration: 0.2s;
}

.mission-button:hover {
    background-color: rgb(0, 255, 255);
    color: rgb(0, 0, 0);
}

.mission-button:active {
    background-color: rgb(0, 200, 200);
}

/* ============================================
   DIALOGUE PANEL (Center Screen)
   ============================================ */

.dialogue-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.8);
}

.dialogue-border {
    width: 800px;
    background-color: rgb(0, 0, 0);
    border-color: rgb(0, 255, 255); /* Cyan */
    border-width: 4px;
    padding: 30px;
}

.dialogue-header-container {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(0, 255, 255);
}

.npc-name {
    font-size: 28px;
    color: rgb(0, 255, 255); /* Cyan */
}

.npc-title {
    font-size: 18px;
    color: rgb(150, 255, 255); /* Lighter cyan */
    -unity-text-align: upper-right;
}

.dialogue-body {
    margin-bottom: 20px;
    padding: 20px;
    background-color: rgba(0, 255, 255, 0.05);
}

.dialogue-text {
    font-size: 20px;
    color: rgb(200, 200, 200); /* Light gray */
    white-space: normal;
}

.continue-prompt {
    align-items: flex-end;
}

.continue-text {
    font-size: 14px;
    color: rgb(0, 255, 255); /* Cyan */
}

/* ============================================
   LAP REWARD PANEL (Center Screen, After Lap)
   ============================================ */

.lap-reward-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.8);
}

.reward-border {
    width: 600px;
    background-color: rgb(0, 0, 0);
    border-color: rgb(0, 255, 255); /* Cyan */
    border-width: 4px;
    padding: 30px;
    align-items: center;
}

.reward-header {
    font-size: 32px;
    color: rgb(0, 255, 255); /* Cyan */
    margin-bottom: 20px;
    -unity-text-align: upper-center;
}

.cash-earned {
    font-size: 48px;
    color: rgb(0, 255, 0); /* Green for money */
    margin-bottom: 10px;
    -unity-text-align: upper-center;
}

.bonus-label {
    font-size: 20px;
    color: rgb(255, 255, 0); /* Yellow for bonus */
    margin-bottom: 15px;
    -unity-text-align: upper-center;
}

.lap-time-display {
    font-size: 22px;
    color: rgb(200, 200, 200); /* Light gray */
    margin-bottom: 20px;
    -unity-text-align: upper-center;
}

.message-container {
    width: 100%;
    margin-top: 10px;
    margin-bottom: 20px;
}

.reward-message {
    font-size: 18px;
    color: rgb(0, 255, 255); /* Cyan */
    -unity-text-align: upper-center;
    white-space: normal;
}

.reward-button {
    background-color: transparent;
    border-color: rgb(0, 255, 255); /* Cyan */
    border-width: 2px;
    color: rgb(0, 255, 255);
    font-size: 16px;
    padding: 10px 20px;
    margin-top: 10px;
    transition-duration: 0.2s;
}

.reward-button:hover {
    background-color: rgb(0, 255, 255);
    color: rgb(0, 0, 0);
}

.reward-button:active {
    background-color: rgb(0, 200, 200);
}

/* ============================================
   OPTIONAL EFFECTS
   ============================================ */

