/* ========================================
   CD26 - Game HUD Stylesheet
   Customize colors, sizes, and positioning here!
   ======================================== */

/* === HUD CONTAINER (Always Visible) === */
.hud-container {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: column;
}

/* === SHARED INFO PANEL STYLES === */
.info-panel {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 10px;
    padding: 15px 20px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
}

/* === SPEEDOMETER (Bottom-Left) === */
.speedometer {
    bottom: 30px;
    left: 30px;
    flex-direction: row;
    align-items: flex-end;
}

.speed-value {
    font-size: 48px;
    color: white;
    -unity-font-style: bold;
    margin-right: 10px;
}

.speed-unit {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 8px;
}

/* === CASH DISPLAY (Top-Right) === */
.cash-display {
    top: 30px;
    right: 30px;
    flex-direction: column;
    align-items: flex-end;
}

.cash-current {
    font-size: 32px;
    color: #4CAF50; /* Green for money */
    -unity-font-style: bold;
}

.cash-goal {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 5px;
}

/* === PAUSE MENU (Hidden by default) === */
.pause-menu {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.pause-menu.hidden {
    display: none;
}

/* Semi-transparent dark overlay */
.pause-background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
}

/* Central pause panel */
.pause-panel {
    width: 500px;
    background-color: rgba(30, 30, 30, 0.95);
    border-radius: 20px;
    padding: 40px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.2);
}

.pause-title {
    font-size: 48px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 30px;
    letter-spacing: 5px;
}

/* === VOLUME SECTION === */
.menu-section {
    margin-bottom: 30px;
}

.volume-label {
    font-size: 20px;
    color: white;
    margin-bottom: 10px;
}

.volume-slider {
    height: 30px;
    margin-bottom: 10px;
}

/* Customize slider colors */
.volume-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 5px;
}

.volume-slider .unity-base-slider__dragger {
    background-color: white;
    border-radius: 50%;
    width: 20px;
    height: 20px;
}

.volume-percentage {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
}

/* === BUTTONS === */
.button-container {
    flex-direction: column;
    margin-top: 20px;
}

.menu-button {
    height: 60px;
    font-size: 24px;
    margin-bottom: 15px;
    border-radius: 10px;
    border-width: 2px;
    transition-duration: 0.2s;
}

.resume-button {
    background-color: rgba(76, 175, 80, 0.8); /* Green */
    border-color: rgba(76, 175, 80, 1);
    color: white;
}

.resume-button:hover {
    background-color: rgba(76, 175, 80, 1);
    scale: 1.05;
}

.quit-button {
    background-color: rgba(244, 67, 54, 0.8); /* Red */
    border-color: rgba(244, 67, 54, 1);
    color: white;
}

.quit-button:hover {
    background-color: rgba(244, 67, 54, 1);
    scale: 1.05;
}

/* ========================================
   CUSTOMIZATION TIPS:
   
   - Change colors: rgba(R, G, B, Alpha)
   - Change sizes: font-size, width, height
   - Change positions: top, bottom, left, right
   - Change spacing: margin, padding
   - Border styles: border-width, border-color, border-radius
   
   Example: Make speedometer bigger
   .speed-value { font-size: 60px; }
   
   Example: Move cash display lower
   .cash-display { top: 100px; }
   ======================================== */
