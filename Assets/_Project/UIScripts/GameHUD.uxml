<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UIScripts/GameHUD.uss?fileID=7433441132597879392&amp;guid=035421176377ae040932ab49b9abfcd5&amp;type=3#GameHUD"/>
    <ui:VisualElement name="hud-container" class="hud-container">
        <ui:VisualElement name="info-panel" class="info-panel">
            <ui:VisualElement name="cash-display" class="cash-display">
                <ui:Label name="cash-current" text="$0" class="cash-current"/>
                <ui:Label name="cash-goal" text="/ $10,000 Goal" class="cash-goal"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="speedometer" class="speedometer">
            <ui:Label name="speed-value" text="0" class="speed-value"/>
            <ui:Label name="speed-unit" text="km/h" class="speed-unit"/>
        </ui:VisualElement>
        <ui:VisualElement name="interaction-prompt" class="interaction-prompt hidden">
            <ui:Label name="interaction-text" text="Press E to Enter Vehicle" class="interaction-text"/>
        </ui:VisualElement>
        
        <!-- NEW: LAP TIMER PANEL (visible during lap) -->
        <ui:VisualElement name="lap-timer-panel" class="lap-timer-panel hidden">
            <ui:Label name="current-lap-time" text="Current: 0:00.00" class="lap-time-current"/>
            <ui:Label name="personal-best-time" text="Best: --:--.-" class="lap-time-best"/>
        </ui:VisualElement>
    </ui:VisualElement>
    
    <!-- PAUSE MENU -->
    <ui:VisualElement name="pause-menu" class="pause-menu hidden">
        <ui:VisualElement name="pause-panel" class="pause-panel">
            <ui:Label text="PAUSED" class="pause-title"/>
            <ui:Label text="Volume" class="volume-label"/>
            <ui:Slider name="volume-slider" low-value="0" high-value="1" value="0.75" class="volume-slider"/>
            <ui:Label name="volume-percentage" text="75%" class="volume-percentage"/>
            <ui:Button name="resume-button" text="Resume" class="menu-button"/>
            <ui:Button name="quit-button" text="Quit to Menu" class="menu-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
    
    <!-- MISSION PANEL -->
    <ui:VisualElement name="mission-panel" class="mission-panel hidden">
        <ui:VisualElement name="mission-border" class="mission-border">
            <ui:Label name="mission-header" text="MISSION BRIEFING" class="mission-header"/>
            <ui:Label name="mission-name" text="FIRST LAP" class="mission-name"/>
            <ui:Label name="mission-description" text="Complete one lap around the track." class="mission-description"/>
            <ui:VisualElement name="reward-container" class="reward-container">
                <ui:Label text="REWARD:" class="reward-label"/>
                <ui:Label name="mission-reward" text="$500" class="mission-reward-value"/>
            </ui:VisualElement>
            <ui:Button name="mission-accept-button" text="[PRESS ENTER TO START]" class="mission-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
    
    <!-- DIALOGUE PANEL (1992 Aesthetic) -->
    <ui:VisualElement name="dialogue-panel" class="dialogue-panel hidden">
        <ui:VisualElement name="dialogue-border" class="dialogue-border">
            <ui:VisualElement name="dialogue-header-container" class="dialogue-header-container">
                <ui:Label name="npc-name" text="MARIA" class="npc-name"/>
                <ui:Label name="npc-title" text="Cafe Owner" class="npc-title"/>
            </ui:VisualElement>
            <ui:VisualElement name="dialogue-body" class="dialogue-body">
                <ui:Label name="dialogue-text" text="Welcome to my cafe! Can I get you something?" class="dialogue-text"/>
            </ui:VisualElement>
            <ui:VisualElement name="continue-prompt" class="continue-prompt">
                <ui:Label text="[PRESS E OR SPACE TO CONTINUE]" class="continue-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    
    <!-- NEW: LAP REWARD PANEL (shown after lap completion) -->
    <ui:VisualElement name="lap-reward-panel" class="lap-reward-panel hidden">
        <ui:VisualElement name="reward-border" class="reward-border">
            <ui:Label name="reward-header" text="LAP COMPLETE" class="reward-header"/>
            <ui:Label name="cash-earned" text="+$500" class="cash-earned"/>
            <ui:Label name="bonus-label" text="NEW PERSONAL BEST!" class="bonus-label hidden"/>
            <ui:Label name="lap-time" text="Lap Time: 1:23.45" class="lap-time-display"/>
            <ui:VisualElement name="message-container" class="message-container">
                <ui:Label name="reward-message" text="Return to Uncle Ray at the garage" class="reward-message"/>
            </ui:VisualElement>
            <ui:Button name="continue-button" text="[PRESS ENTER TO CONTINUE]" class="reward-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
    
    <!-- DEBUG PANEL (F12 to toggle) -->
    <ui:VisualElement name="debug-panel" class="debug-panel hidden">
        <ui:Label text="DEBUG INFO (F12)" class="debug-header"/>
        <ui:Label name="debug-state" text="State: Walking" class="debug-line"/>
        <ui:Label name="debug-mission" text="Mission: None" class="debug-line"/>
        <ui:Label name="debug-position" text="Pos: (0, 0, 0)" class="debug-line"/>
        <ui:Label name="debug-controls" text="Controls: Keyboard" class="debug-line"/>
    </ui:VisualElement>
</ui:UXML>
