<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UIScripts/GameHUD.uss?fileID=7433441132597879392&amp;guid=035421176377ae040932ab49b9abfcd5&amp;type=3#GameHUD"/>
    <ui:VisualElement name="hud-container" class="hud-container">
        <ui:VisualElement name="speedometer-panel" class="info-panel speedometer">
            <ui:Label text="0" name="speed-value" class="speed-value"/>
            <ui:Label text="km/h" name="speed-unit" class="speed-unit"/>
        </ui:VisualElement>
        <ui:VisualElement name="cash-panel" class="info-panel cash-display">
            <ui:Label text="$0" name="cash-current" class="cash-current"/>
            <ui:Label text="/ $10,000 Goal" name="cash-goal" class="cash-goal"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="pause-menu" class="pause-menu hidden">
        <ui:VisualElement name="pause-background" class="pause-background"/>
        <ui:VisualElement name="pause-panel" class="pause-panel">
            <ui:Label text="PAUSED" name="pause-title" class="pause-title"/>
            <ui:VisualElement name="volume-container" class="menu-section">
                <ui:Label text="Car Audio Volume" class="volume-label"/>
                <ui:Slider name="volume-slider" low-value="0" high-value="1" value="0.75" class="volume-slider"/>
                <ui:Label text="75%" name="volume-percentage" class="volume-percentage"/>
            </ui:VisualElement>
            <ui:VisualElement name="button-container" class="button-container">
                <ui:Button text="Resume" name="resume-button" class="menu-button resume-button"/>
                <ui:Button text="Quit to Menu" name="quit-button" class="menu-button quit-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
